{
  "entities": {
    "Todo": {
      "title": "Todo",
      "description": "A task that a user needs to complete.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The description of the task."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the task is completed."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who owns the task."
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp of creation."
        }
      },
      "required": ["text", "completed", "userId", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Registered user profile.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address."
        },
        "displayName": {
          "type": "string",
          "description": "User display name."
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL."
        },
        "lastLoginAt": {
          "type": "number",
          "description": "Timestamp of last login."
        },
        "clockState": {
          "type": "string",
          "description": "clock in or out state"
        },
        "clockTime": {
          "type": "string",
          "description": "time of clock state"
        },
        "companyCode": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "employeeId": {
          "type": "string"
        },
        "isProfileComplete": {
          "type": "boolean"
        },
        "role": {
          "type": "string"
        }
      },
      "required": ["email", "lastLoginAt"]
    },
    "Event": {
      "title": "Event",
      "description": "Calendar event",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "title", "date", "type", "createdAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "CRM Customer",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "name", "email", "phone", "company", "status", "createdAt"]
    },
    "CompanyCode": {
      "title": "CompanyCode",
      "description": "Company registration codes managed by HQ workspace.",
      "type": "object",
      "properties": {
        "companyCode": { "type": "string" },
        "companyName": { "type": "string" },
        "password": { "type": "string" },
        "firstLoggedUser": { "type": "string" },
        "registeredUsersCount": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyCode", "companyName", "password", "createdAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Stores user daily check in/out details and metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "checkIn": { "type": "string" },
        "checkOut": { "type": "string" },
        "authType": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "ipAddress": { "type": "string" },
        "status": { "type": "string" },
        "companyCode": { "type": "string" },
        "workHours": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "date", "checkIn", "status", "createdAt"]
    },
    "Leave": {
      "title": "Leave",
      "description": "Annual leaves and overtime applications and approvals.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "companyCode": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "type", "startDate", "endDate", "status", "createdAt"]
    },
    "WorkPolicy": {
      "title": "WorkPolicy",
      "description": "Company wide custom work time policies and auth conditions.",
      "type": "object",
      "properties": {
        "companyCode": { "type": "string" },
        "standardIn": { "type": "string" },
        "standardOut": { "type": "string" },
        "weeklyHours": { "type": "number" },
        "officeLatitude": { "type": "number" },
        "officeLongitude": { "type": "number" },
        "allowedIp": { "type": "string" },
        "policyType": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["companyCode", "standardIn", "standardOut", "weeklyHours"]
    }
  },
  "firestore": {
    "company_codes/{codeId}": {
      "schema": {
        "$ref": "#/entities/CompanyCode"
      },
      "description": "Stores company codes, passwords and assigned admin info."
    },
    "todos/{todoId}": {
      "schema": {
        "$ref": "#/entities/Todo"
      },
      "description": "Stores user tasks."
    },
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores registered user profiles."
    },
    "events/{eventId}": {
      "schema": {
        "$ref": "#/entities/Event"
      },
      "description": "Stores calendar events"
    },
    "customers/{customerId}": {
      "schema": {
        "$ref": "#/entities/Customer"
      },
      "description": "Stores CRM customers"
    },
    "attendances/{attendanceId}": {
      "schema": {
        "$ref": "#/entities/AttendanceRecord"
      },
      "description": "Stores user daily check in/out details and metadata."
    },
    "leaves/{leaveId}": {
      "schema": {
        "$ref": "#/entities/Leave"
      },
      "description": "Stores annual leaves/overtime applications."
    },
    "work_policies/{policyId}": {
      "schema": {
        "$ref": "#/entities/WorkPolicy"
      },
      "description": "Stores custom corporate work policies."
    }
  }
}
